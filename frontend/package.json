{
  "name": "frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun run assets && vite",
    "build": "bun run assets && vite build",
    "preview": "vite preview",
    "lint": "oxlint src scripts/assets scripts/inspect tests --ignore-pattern src/assets/generated",
    "typecheck": "bun run assets && tsc --noEmit && tsc -p scripts/assets/tsconfig.json && tsc -p tests/tsconfig.json && tsc -p scripts/inspect/tsconfig.json",
    "format": "oxfmt --check src scripts/assets scripts/inspect tests playwright.config.ts --ignore-path .prettierignore",
    "format:write": "oxfmt --write src scripts/assets scripts/inspect tests playwright.config.ts --ignore-path .prettierignore",
    "assets": "node scripts/assets/build.ts",
    "assets:check": "node scripts/assets/check.ts",
    "assets:preview": "node scripts/assets/preview.ts",
    "assets:test": "bun test scripts/assets",
    "inspect": "bun scripts/inspect/cli.ts"
  },
  "dependencies": {
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.1",
    "@tanstack/react-virtual": "^3.14.13",
    "@types/three": "^0.186.0",
    "html2canvas": "^1.4.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.4",
    "recharts": "^3.10.1",
    "three": "^0.186.1",
    "uuid": "^14.0.2",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@gltf-transform/cli": "^4.5.1",
    "@gltf-transform/core": "^4.5.1",
    "@gltf-transform/extensions": "^4.5.1",
    "@gltf-transform/functions": "^4.5.1",
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/bun": "1.4.2",
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "oxfmt": "^0.71.0",
    "oxlint": "^1.86.0",
    "postcss": "^8.5.28",
    "sharp": "0.35.5",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.1"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "engines": {
    "node": ">=26.10.0",
    "bun": ">=1.4.2"
  },
  "packageManager": "bun@1.4.2"
}
